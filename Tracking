<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Freelance Town: ANM ✕ CRE Quest Hub</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- PapaParse: Giải quyết triệt để lỗi dính chùm cột CSV -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Google Fonts: Retro Mid-Century & Cute Game -->
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            game: ['Fredoka', 'sans-serif'],
            sans: ['Outfit', 'sans-serif'],
          },
          colors: {
            latte: '#F5EFEB',
            creamy: '#FFFDF9',
            espresso: '#3A271D',
            mustard: '#EAA228',
            mustardLight: '#FEF4D6',
            sage: '#7C9885',
            sageLight: '#E3EDE6',
            coral: '#D96552',
            coralLight: '#FCEAE7',
            sky: '#4A7C9B',
            skyLight: '#E2ECF3',
            lavender: '#8B789D',
            lavenderLight: '#ECE6F2',
          },
          boxShadow: {
            'retro': '4px 4px 0px #3A271D',
            'retro-lg': '6px 6px 0px #3A271D',
            'retro-sm': '2px 2px 0px #3A271D',
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #F5EFEB;
      color: #3A271D;
      background-image: radial-gradient(#3A271D 1px, transparent 1px);
      background-size: 26px 26px;
    }
    .btn-bouncy {
      transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .btn-bouncy:hover {
      transform: translateY(-2px);
    }
    .btn-bouncy:active {
      transform: translate(3px, 3px);
      box-shadow: 0px 0px 0px #3A271D !important;
    }
    /* Thanh cuộn phong cách retro */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #F5EFEB; border-left: 2px solid #3A271D; }
    ::-webkit-scrollbar-thumb { background: #EAA228; border-radius: 4px; border: 2px solid #3A271D; }
  </style>
</head>
<body class="min-h-screen p-4 md:p-8 flex flex-col items-center">

  <!-- TOP STATUS & CONTROLLER BAR -->
  <header class="w-full max-w-6xl mb-6 bg-creamy p-4 rounded-3xl border-3 border-espresso shadow-retro-lg flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 bg-mustard rounded-2xl border-2 border-espresso flex items-center justify-center text-2xl shadow-retro transform -rotate-3 animate-pulse">
        🏡
      </div>
      <div>
        <h1 class="text-xl md:text-2xl font-bold font-game tracking-tight text-espresso flex items-center gap-2">
          FREELANCE TOWN (ANM ✕ CRE)
          <span class="text-[10px] bg-coral text-creamy px-2 py-0.5 rounded-full border border-espresso uppercase font-game">Game Hub</span>
        </h1>
        <p class="text-xs text-espresso/70 font-medium">Bấm vào từng khu vực để kích hoạt nhiệm vụ & bảng dữ liệu</p>
      </div>
    </div>

    <!-- CẮM LINK GOOGLE SHEET CSV -->
    <div class="flex items-center gap-2 w-full md:w-auto">
      <input 
        id="sheetUrlInput"
        type="text" 
        placeholder="🔗 Dán link Google Sheet CSV..." 
        class="flex-1 md:w-72 px-3 py-2 text-xs bg-latte border-2 border-espresso rounded-xl focus:outline-none focus:bg-white shadow-retro-sm font-medium"
      />
      <button 
        onclick="syncDataFromCSV()" 
        class="px-4 py-2 bg-sage hover:bg-sage/90 text-white font-game text-xs font-bold rounded-xl border-2 border-espresso shadow-retro btn-bouncy flex items-center gap-1"
      >
        <span>🔄</span> Cập nhật
      </button>
      <button 
        onclick="resetMockData()" 
        title="Dùng dữ liệu mẫu" 
        class="px-3 py-2 bg-latte text-espresso font-game text-xs rounded-xl border-2 border-espresso shadow-retro-sm btn-bouncy"
      >
        Demo
      </button>
    </div>
  </header>

  <!-- GAME TOWN MAP: 4 KHU VỰC TƯƠNG TÁC CHÍNH -->
  <main class="w-full max-w-6xl mb-8">
    <div class="text-center mb-6">
      <span class="bg-mustardLight text-mustard border-2 border-espresso px-4 py-1 rounded-full font-game text-xs font-bold shadow-retro-sm inline-block transform -rotate-1">
        ✨ CHỌN ĐỊA ĐIỂM BẠN MUỐN ĐẾN ĐỂ MỞ TÍNH NĂNG ✨
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      
      <!-- STATION 1: BẢNG 19 CỘT DỮ LIỆU -->
      <div 
        onclick="openModal('modalTable')" 
        class="bg-creamy hover:bg-skyLight/30 border-3 border-espresso rounded-3xl p-5 shadow-retro-lg cursor-pointer btn-bouncy flex flex-col justify-between group transition-all"
      >
        <div>
          <div class="w-14 h-14 bg-sky text-white rounded-2xl border-2 border-espresso flex items-center justify-center text-3xl shadow-retro mb-4 group-hover:scale-110 transition-transform">
            📊
          </div>
          <span class="text-[10px] font-game bg-skyLight text-sky px-2 py-0.5 rounded-md border border-espresso uppercase font-bold">Trạm 1</span>
          <h2 class="font-game text-lg font-bold text-espresso mt-1">BẢNG DỮ LIỆU 19 CỘT</h2>
          <p class="text-xs text-espresso/70 mt-1 leading-snug">Toàn bộ 19 cột phân vùng 5 Zone: PnL, Trình ký, Tiền nong, Next step.</p>
        </div>
        <div class="mt-4 pt-3 border-t-2 border-espresso/20 flex items-center justify-between text-xs font-game font-bold text-sky">
          <span>Mở Sổ Cái</span>
          <span>➔</span>
        </div>
      </div>

      <!-- STATION 2: BẢNG TRACKING TIẾN ĐỘ PO (KANBAN) -->
      <div 
        onclick="openModal('modalKanban')" 
        class="bg-creamy hover:bg-coralLight/30 border-3 border-espresso rounded-3xl p-5 shadow-retro-lg cursor-pointer btn-bouncy flex flex-col justify-between group transition-all"
      >
        <div>
          <div class="w-14 h-14 bg-coral text-white rounded-2xl border-2 border-espresso flex items-center justify-center text-3xl shadow-retro mb-4 group-hover:scale-110 transition-transform">
            📋
          </div>
          <span class="text-[10px] font-game bg-coralLight text-coral px-2 py-0.5 rounded-md border border-espresso uppercase font-bold">Trạm 2</span>
          <h2 class="font-game text-lg font-bold text-espresso mt-1">TRACKING KÝ PO</h2>
          <p class="text-xs text-espresso/70 mt-1 leading-snug">Kanban board 4 bước: Chưa trình ➔ Đã trình ➔ Đã ký ➔ Đã gửi Vendor.</p>
        </div>
        <div class="mt-4 pt-3 border-t-2 border-espresso/20 flex items-center justify-between text-xs font-game font-bold text-coral">
          <span>Xem Tiến Độ</span>
          <span>➔</span>
        </div>
      </div>

      <!-- STATION 3: BƯU ĐIỆN MẪU EMAIL LEGAL & FIN -->
      <div 
        onclick="openModal('modalEmail')" 
        class="bg-creamy hover:bg-mustardLight/30 border-3 border-espresso rounded-3xl p-5 shadow-retro-lg cursor-pointer btn-bouncy flex flex-col justify-between group transition-all"
      >
        <div>
          <div class="w-14 h-14 bg-mustard text-espresso rounded-2xl border-2 border-espresso flex items-center justify-center text-3xl shadow-retro mb-4 group-hover:scale-110 transition-transform">
            📮
          </div>
          <span class="text-[10px] font-game bg-mustardLight text-mustard px-2 py-0.5 rounded-md border border-espresso uppercase font-bold">Trạm 3</span>
          <h2 class="font-game text-lg font-bold text-espresso mt-1">SOẠN EMAIL 1-CLICK</h2>
          <p class="text-xs text-espresso/70 mt-1 leading-snug">Tự động điền Campaign & PO ID xin số PO FIN, review BBNT kèm nút copy.</p>
        </div>
        <div class="mt-4 pt-3 border-t-2 border-espresso/20 flex items-center justify-between text-xs font-game font-bold text-mustard">
          <span>Gửi Thư Ngay</span>
          <span>➔</span>
        </div>
      </div>

      <!-- STATION 4: NHÀ TRỢ LÝ PUDDING BOT -->
      <div 
        onclick="openModal('modalBot')" 
        class="bg-creamy hover:bg-lavenderLight/30 border-3 border-espresso rounded-3xl p-5 shadow-retro-lg cursor-pointer btn-bouncy flex flex-col justify-between group transition-all"
      >
        <div>
          <div class="w-14 h-14 bg-lavender text-white rounded-2xl border-2 border-espresso flex items-center justify-center text-3xl shadow-retro mb-4 group-hover:scale-110 transition-transform">
            🍮
          </div>
          <span class="text-[10px] font-game bg-lavenderLight text-lavender px-2 py-0.5 rounded-md border border-espresso uppercase font-bold">Trạm 4</span>
          <h2 class="font-game text-lg font-bold text-espresso mt-1">TRỢ LÝ PUDDING</h2>
          <p class="text-xs text-espresso/70 mt-1 leading-snug">Hỏi nhanh tiến độ của Trâm, Nga, Phong hoặc hỏi bước cần làm tiếp theo.</p>
        </div>
        <div class="mt-4 pt-3 border-t-2 border-espresso/20 flex items-center justify-between text-xs font-game font-bold text-lavender">
          <span>Trò Chuyện</span>
          <span>➔</span>
        </div>
      </div>

    </div>

    <!-- TICKER METRICS TỔNG TIỀN NỢ (COZY DASHBOARD MINI) -->
    <div class="mt-6 bg-creamy border-3 border-espresso rounded-3xl p-4 shadow-retro flex flex-col sm:flex-row items-center justify-around gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">👩‍💻</span>
        <div>
          <div class="text-[11px] font-game font-bold text-coral uppercase">Tổng Tiền Freelance Chờ Đi Tiền:</div>
          <div id="quickFreelanceUnpaid" class="text-xl font-bold font-game text-espresso">0 ₫</div>
        </div>
      </div>
      <div class="h-8 w-0.5 bg-espresso/20 hidden sm:block"></div>
      <div class="flex items-center gap-3">
        <span class="text-2xl">🏢</span>
        <div>
          <div class="text-[11px] font-game font-bold text-mustard uppercase">Tổng Tiền CRE Vendor (/0.9/1.1):</div>
          <div id="quickVendorUnpaid" class="text-xl font-bold font-game text-espresso">0 ₫</div>
        </div>
      </div>
    </div>
  </main>

  <!-- ==================== CÁC MODAL BẢNG & TÍNH NĂNG (BẤM LÀ BUNG RA) ==================== -->

  <!-- MODAL 1: BẢNG DỮ LIỆU 19 CỘT -->
  <div id="modalTable" class="fixed inset-0 bg-espresso/60 backdrop-blur-xs z-50 flex items-center justify-center p-3 hidden">
    <div class="bg-creamy border-3 border-espresso rounded-3xl max-w-7xl w-full h-[90vh] flex flex-col shadow-retro-lg overflow-hidden animate-in fade-in zoom-in duration-150">
      <div class="p-4 bg-latte border-b-2 border-espresso flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📊</span>
          <h3 class="font-game text-lg font-bold text-espresso">BẢNG DỮ LIỆU 19 CỘT CHUẨN XÁC</h3>
        </div>
        <div class="flex items-center gap-2">
          <input 
            type="text" 
            id="tableSearchInput" 
            oninput="renderTable()" 
            placeholder="Tìm bạn Freelance, CAM..." 
            class="text-xs bg-white border border-espresso px-3 py-1.5 rounded-xl font-medium"
          />
          <button onclick="closeModal('modalTable')" class="w-8 h-8 rounded-full bg-coral text-white font-game font-bold border-2 border-espresso flex items-center justify-center shadow-retro-sm btn-bouncy">✕</button>
        </div>
      </div>

      <div class="flex-1 overflow-auto p-4">
        <table class="w-full text-xs text-left border-collapse whitespace-nowrap">
          <thead class="sticky top-0 z-10 border-b-2 border-espresso text-[11px] font-game tracking-wider">
            <tr>
              <th class="p-2.5 bg-latte border-r border-espresso text-center">Thao tác</th>
              <th class="p-2.5 bg-sky text-white border-r border-espresso">1. Entity</th>
              <th class="p-2.5 bg-sky text-white border-r border-espresso">2. Tên Campaign</th>
              <th class="p-2.5 bg-sky text-white border-r border-espresso">3. Freelance</th>
              <th class="p-2.5 bg-sky text-white border-r border-espresso">4. Link/Tên File PnL</th>
              <th class="p-2.5 bg-sky text-white border-r-2 border-espresso">5. SOW</th>
              <th class="p-2.5 bg-mustard text-espresso border-r border-espresso">6. Trạng thái PO</th>
              <th class="p-2.5 bg-mustard text-espresso border-r border-espresso">7. PO ID / PO No</th>
              <th class="p-2.5 bg-coral text-white border-r border-espresso">8. Trình ký PO</th>
              <th class="p-2.5 bg-mustard text-espresso border-r border-espresso">9. Trạng thái PnL</th>
              <th class="p-2.5 bg-mustard text-espresso border-r-2 border-espresso">10. File PnL</th>
              <th class="p-2.5 bg-sage text-white border-r border-espresso">11. Tiền Freelance</th>
              <th class="p-2.5 bg-sage text-white border-r border-espresso">12. Vendor</th>
              <th class="p-2.5 bg-mustard text-espresso border-r border-espresso">13. Tiền Vendor (Auto)</th>
              <th class="p-2.5 bg-sage text-white border-r border-espresso">14. Điền Tiền FIN</th>
              <th class="p-2.5 bg-sage text-white border-r border-espresso">15. Ngày Đi Tiền FIN</th>
              <th class="p-2.5 bg-sage text-white border-r-2 border-espresso">16. Điền Tiền CRE</th>
              <th class="p-2.5 bg-lavender text-white border-r border-espresso">17. TRẠNG THÁI</th>
              <th class="p-2.5 bg-sage text-white border-r border-espresso min-w-[280px]">18. Next step</th>
              <th class="p-2.5 bg-lavender text-white">19. DRIVE</th>
            </tr>
          </thead>
          <tbody id="tableBody" class="divide-y divide-espresso/20 font-medium bg-white">
            <!-- Data render -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- MODAL 2: BẢNG KANBAN TIẾN ĐỘ PO -->
  <div id="modalKanban" class="fixed inset-0 bg-espresso/60 backdrop-blur-xs z-50 flex items-center justify-center p-3 hidden">
    <div class="bg-creamy border-3 border-espresso rounded-3xl max-w-6xl w-full h-[85vh] flex flex-col shadow-retro-lg overflow-hidden animate-in fade-in zoom-in duration-150">
      <div class="p-4 bg-latte border-b-2 border-espresso flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📋</span>
          <h3 class="font-game text-lg font-bold text-espresso">BẢNG TIẾN ĐỘ TRÌNH KÝ PO (KANBAN BOARD)</h3>
        </div>
        <button onclick="closeModal('modalKanban')" class="w-8 h-8 rounded-full bg-coral text-white font-game font-bold border-2 border-espresso flex items-center justify-center shadow-retro-sm btn-bouncy">✕</button>
      </div>

      <div class="flex-1 overflow-auto p-4 grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Cột 1: Chưa trình -->
        <div class="bg-latte p-3 rounded-2xl border-2 border-espresso flex flex-col">
          <div class="font-game text-xs font-bold text-espresso mb-3 flex items-center justify-between pb-2 border-b border-espresso/20">
            <span>⚪ 1. CHƯA TRÌNH</span>
            <span id="badgeCount_ChuaTrinh" class="bg-white px-2 py-0.5 rounded-full border border-espresso text-[10px]">0</span>
          </div>
          <div id="kanbanCol_ChuaTrinh" class="flex-1 space-y-2 overflow-y-auto"></div>
        </div>

        <!-- Cột 2: Đã trình -->
        <div class="bg-mustardLight p-3 rounded-2xl border-2 border-espresso flex flex-col">
          <div class="font-game text-xs font-bold text-mustard mb-3 flex items-center justify-between pb-2 border-b border-espresso/20">
            <span>🟡 2. ĐÃ TRÌNH (CHỜ HUY)</span>
            <span id="badgeCount_DaTrinh" class="bg-white px-2 py-0.5 rounded-full border border-espresso text-[10px]">0</span>
          </div>
          <div id="kanbanCol_DaTrinh" class="flex-1 space-y-2 overflow-y-auto"></div>
        </div>

        <!-- Cột 3: Đã ký -->
        <div class="bg-coralLight p-3 rounded-2xl border-2 border-espresso flex flex-col">
          <div class="font-game text-xs font-bold text-coral mb-3 flex items-center justify-between pb-2 border-b border-espresso/20">
            <span>🟢 3. ĐÃ KÝ MỘC</span>
            <span id="badgeCount_DaKy" class="bg-white px-2 py-0.5 rounded-full border border-espresso text-[10px]">0</span>
          </div>
          <div id="kanbanCol_DaKy" class="flex-1 space-y-2 overflow-y-auto"></div>
        </div>

        <!-- Cột 4: Đã gửi Vendor -->
        <div class="bg-sageLight p-3 rounded-2xl border-2 border-espresso flex flex-col">
          <div class="font-game text-xs font-bold text-sage mb-3 flex items-center justify-between pb-2 border-b border-espresso/20">
            <span>🔵 4. ĐÃ GỬI VENDOR</span>
            <span id="badgeCount_DaGuiVendor" class="bg-white px-2 py-0.5 rounded-full border border-espresso text-[10px]">0</span>
          </div>
          <div id="kanbanCol_DaGuiVendor" class="flex-1 space-y-2 overflow-y-auto"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL 3: BƯU ĐIỆN EMAIL (1-CLICK COPY) -->
  <div id="modalEmail" class="fixed inset-0 bg-espresso/60 backdrop-blur-xs z-50 flex items-center justify-center p-3 hidden">
    <div class="bg-creamy border-3 border-espresso rounded-3xl max-w-xl w-full p-5 shadow-retro-lg overflow-hidden animate-in fade-in zoom-in duration-150">
      <div class="flex items-center justify-between pb-3 border-b-2 border-espresso mb-4">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📮</span>
          <h3 class="font-game text-lg font-bold text-espresso">MẪU EMAIL REVIEW BBNT & XIN SỐ PO</h3>
        </div>
        <button onclick="closeModal('modalEmail')" class="w-8 h-8 rounded-full bg-coral text-white font-game font-bold border-2 border-espresso flex items-center justify-center shadow-retro-sm btn-bouncy">✕</button>
      </div>

      <div class="space-y-3 text-xs mb-4">
        <div class="grid grid-cols-2 gap-2">
          <div><label class="font-game text-[10px] text-espresso/70">Entity:</label><input id="emailField_entity" value="AMV" oninput="updateEmailBox()" class="w-full bg-latte p-2 rounded-xl border border-espresso font-semibold"></div>
          <div><label class="font-game text-[10px] text-espresso/70">Tên Campaign:</label><input id="emailField_cam" value="TikTok Campaign 2026" oninput="updateEmailBox()" class="w-full bg-latte p-2 rounded-xl border border-espresso font-semibold"></div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="font-game text-[10px] text-espresso/70">PO ID / CAM ID:</label><input id="emailField_id" value="CAM0083383" oninput="updateEmailBox()" class="w-full bg-latte p-2 rounded-xl border border-espresso font-semibold"></div>
          <div><label class="font-game text-[10px] text-espresso/70">PIC Legal / FIN:</label><input id="emailField_pic" value="Hảo" oninput="updateEmailBox()" class="w-full bg-latte p-2 rounded-xl border border-espresso font-semibold"></div>
        </div>

        <div>
          <label class="font-game text-[10px] text-espresso/70">Nội dung hoàn chỉnh:</label>
          <div id="emailBoxContent" class="bg-white p-3 rounded-xl border-2 border-espresso font-mono text-xs whitespace-pre-wrap leading-relaxed max-h-48 overflow-y-auto"></div>
        </div>
      </div>

      <button onclick="copyEmailText()" class="w-full py-2.5 bg-mustard hover:bg-mustard/90 text-espresso font-game font-bold rounded-xl border-2 border-espresso shadow-retro btn-bouncy flex items-center justify-center gap-2">
        <span>📋</span> COPY NỘI DUNG VÀ TIÊU ĐỀ
      </button>
    </div>
  </div>

  <!-- MODAL 4: TRỢ LÝ PUDDING BOT -->
  <div id="modalBot" class="fixed inset-0 bg-espresso/60 backdrop-blur-xs z-50 flex items-center justify-center p-3 hidden">
    <div class="bg-creamy border-3 border-espresso rounded-3xl max-w-lg w-full p-5 shadow-retro-lg overflow-hidden animate-in fade-in zoom-in duration-150">
      <div class="flex items-center justify-between pb-3 border-b-2 border-espresso mb-4">
        <div class="flex items-center gap-2">
          <span class="text-3xl animate-bounce">🍮</span>
          <div>
            <h3 class="font-game text-base font-bold text-espresso">PUDDING BOT COMPANION</h3>
            <p class="text-[11px] text-espresso/60">Gõ tên bạn Freelance để Bot báo trạng thái tức thì</p>
          </div>
        </div>
        <button onclick="closeModal('modalBot')" class="w-8 h-8 rounded-full bg-coral text-white font-game font-bold border-2 border-espresso flex items-center justify-center shadow-retro-sm btn-bouncy">✕</button>
      </div>

      <div class="flex gap-2 mb-3">
        <input 
          id="botQueryInput" 
          type="text" 
          placeholder="VD: Trâm, Nga, khi nào báo Diễm..." 
          onkeydown="if(event.key === 'Enter') handleBotAsk()" 
          class="flex-1 bg-latte p-2.5 text-xs rounded-xl border-2 border-espresso font-medium focus:outline-none focus:bg-white"
        />
        <button onclick="handleBotAsk()" class="px-4 py-2 bg-lavender text-white font-game font-bold text-xs rounded-xl border-2 border-espresso shadow-retro btn-bouncy">
          Hỏi
        </button>
      </div>

      <div id="botAnswerBox" class="bg-latte p-3 rounded-2xl border-2 border-espresso text-xs font-medium min-h-[120px] max-h-60 overflow-y-auto">
        👋 Chào bồ! Gõ tên bạn Freelance (hoặc hỏi về Diễm, hóa đơn nháp, ứng tiền) để tớ kiểm tra nhé!
      </div>
    </div>
  </div>

  <!-- SCRIPT LOGIC ENGINE TOÀN BỘ APP -->
  <script>
    // 1. DỮ LIỆU MOCK KHỞI TẠO (CHUẨN 19 CỘT)
    let freelanceData = [
      {
