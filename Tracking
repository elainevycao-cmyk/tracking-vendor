        fillMoneyVendorCre: "N/A",
        statusGeneral: "Chưa bắt đầu",
        nextStep: "👉 Hỏi chị Ngọc xếp Freelance vào PnL tiền đều ➔ Xin anh Huy duyệt PnL",
        driveLink: ""
      },
      {
        entity: "ATV",
        camName: "KOL Review Q3",
        freelanceName: "Phong",
        pnlLink: "PnL_KOL.xlsx",
        sow: "KOL Booking Lead",
        poStatus: "Đã có",
        poId: "PO-2026-112",
        poSignStatus: "Đã ký",
        pnlStatus: "Đã có",
        pnlFile: "PnL_KOL.pdf",
