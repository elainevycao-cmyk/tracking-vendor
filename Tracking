    // 2. ÂM THANH POP CHIME BẰNG WEB AUDIO API
    function playChime(freq = 600) {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.15);
      } catch (e) {}
    }

    // 3. LOGIC NEXT STEP ENGINE (9 QUY TẮC)
    function calcNextStep(row) {
      const { poSignStatus, poId, camName, entity, pnlStatus, fillMoneyFin, vendor, fillMoneyVendorCre } = row;
      if (poSignStatus === 'Đã trình') return '👉 Push anh Huy back ký mộc PO';
      if (poSignStatus === 'Đã ký') return '👉 Gửi PO bản cứng cho CRE làm Hợp đồng & Giấy tờ';
      if (poSignStatus === 'Đã gửi Vendor' && fillMoneyFin !== 'Đã điền') {
        return `👉 Push CRE back giấy tờ ➔ Điền tiền File Nội Bộ FIN ${vendor === 'CRE' ? '& File CRE' : ''}`;
      }
      if (poId && poId !== 'THIẾU') {
        if (!camName || !entity) return '👉 Bổ sung Tên Campaign & Entity ➔ In PO trình anh Huy ký mộc';
        if (poSignStatus === 'Chưa trình') return '👉 In PO trình anh Huy ký mộc';
      }
      if (pnlStatus === 'Chưa có' || pnlStatus === 'false') {
        return '👉 Hỏi chị Ngọc xếp Freelance vào PnL tiền đều ➔ Xin anh Huy duyệt PnL';
      }
      if ((pnlStatus === 'Đã có' || pnlStatus === 'true') && (!poId || poId === 'THIẾU')) {
        return '👉 Collect đủ hồ sơ (BBNT, PO, PnL) ➔ Tạo PO ID Netsuite & Reply Loop xin số PO';
      }
      if (fillMoneyFin === 'Đã điền') {
        if (vendor === 'CRE' && fillMoneyVendorCre !== 'Đã điền') return '👉 Điền thông tin vào File Điền Tiền CRE';
        return '✅ Đã hoàn tất 100% quy trình!';
      }
      return '👉 Kiểm tra tiến độ hồ sơ';
    }

    // 4. PARSER PAPAPARSE CHỐNG DÍNH CỘT CSV GOOGLE SHEET
    function syncDataFromCSV() {
      const url = document.getElementById('sheetUrlInput').value.trim();
      if (!url) {
        alert("Bồ ơi dán link CSV Published vào ô trước nhé!");
        return;
      }
      playChime(700);

      Papa.parse(url, {
        download: true,
        header: false,
        skipEmptyLines: true,
        complete: function(results) {
          const rows = results.data;
          if (rows.length <= 1) {
            alert("Không tìm thấy dữ liệu trong file CSV này!");
            return;
          }

          let parsed = [];
          for (let i = 1; i < rows.length; i++) {
            const r = rows[i];
            if (!r[2]) continue; // Phải có tên Freelance

            const fMoney = parseFloat((r[10] || '0').toString().replace(/[^0-9.-]/g, '')) || 0;
            const vendor = (r[11] || 'CRE').trim();
            const vMoney = vendor === 'CRE' ? (fMoney > 0 ? Math.round(fMoney / 0.9 / 1.1) : 0) : fMoney;

            const rowObj = {
              entity: (r[0] || 'AMV').trim(),
              camName: (r[1] || '').trim(),
              freelanceName: (r[2] || '').trim(),
              pnlLink: (r[3] || '').trim(),
              sow: (r[4] || '').trim(),
              poStatus: (r[5] || 'Chưa có').trim(),
              poId: (r[6] || '').trim(),
              poSignStatus: (r[7] || 'Chưa trình').trim(),
              pnlStatus: (r[8] || 'Chưa có').trim(),
              pnlFile: (r[9] || '').trim(),
              freelanceMoney: fMoney,
              vendor: vendor,
              vendorMoney: vMoney,
              fillMoneyFin: (r[13] || 'Chưa điền').trim(),
              payDateFin: (r[14] || '').trim(),
              fillMoneyVendorCre: (r[15] || 'N/A').trim(),
              statusGeneral: (r[16] || 'Đang xử lý').trim(),
              nextStep: '',
              driveLink: (r[18] || '').trim()
            };
            rowObj.nextStep = calcNextStep(rowObj);
            parsed.push(rowObj);
          }

          freelanceData = parsed;
          renderAll();
          confetti({ particleCount: 50, spread: 60, origin: { y: 0.7 } });
          alert("🎉 Đồng bộ dữ liệu 19 cột từ Google Sheet thành công!");
        },
        error: function(err) {
          alert("Lỗi khi đọc file CSV: " + err.message);
        }
      });
    }

    // 5. CÁC HÀM MỞ / ĐÓNG MODAL
    function openModal(id) {
      playChime(500);
      document.getElementById(id).classList.remove('hidden');
    }
    function closeModal(id) {
      playChime(350);
      document.getElementById(id).classList.add('hidden');
    }

    // 6. RENDER BẢNG 19 CỘT
    function renderTable() {
      const q = (document.getElementById('tableSearchInput')?.value || '').toLowerCase();
      const tbody = document.getElementById('tableBody');
      const filtered = freelanceData.filter(d => 
        d.freelanceName.toLowerCase().includes(q) ||
        d.camName.toLowerCase().includes(q) ||
        d.poId.toLowerCase().includes(q)
      );

      let html = '';
      filtered.forEach((r, idx) => {
        html += `
          <tr class="hover:bg-latte transition-colors">
            <td class="p-2 border-r border-espresso text-center">
              <button onclick="pickForEmail(${idx})" class="px-2 py-0.5 bg-mustard text-espresso font-game font-bold rounded-lg border border-espresso shadow-retro-sm btn-bouncy text-[10px]">
                Mail ✉️
              </button>
            </td>
            <td class="p-2 border-r border-espresso font-bold">${r.entity}</td>
            <td class="p-2 border-r border-espresso">${r.camName || '—'}</td>
            <td class="p-2 border-r border-espresso font-bold text-coral">${r.freelanceName}</td>
            <td class="p-2 border-r border-espresso text-espresso/60">${r.pnlLink || '—'}</td>
            <td class="p-2 border-r-2 border-espresso">${r.sow || '—'}</td>
            <td class="p-2 border-r border-espresso">${r.poStatus}</td>
            <td class="p-2 border-r border-espresso font-mono font-bold text-sky">${r.poId || '—'}</td>
            <td class="p-2 border-r border-espresso font-bold text-coral">${r.poSignStatus}</td>
            <td class="p-2 border-r border-espresso">${r.pnlStatus}</td>
            <td class="p-2 border-r-2 border-espresso">${r.pnlFile || '—'}</td>
            <td class="p-2 border-r border-espresso font-bold text-sage">${r.freelanceMoney.toLocaleString('vi-VN')} ₫</td>
            <td class="p-2 border-r border-espresso">${r.vendor}</td>
            <td class="p-2 border-r border-espresso font-bold text-mustard">${r.vendorMoney.toLocaleString('vi-VN')} ₫</td>
            <td class="p-2 border-r border-espresso">${r.fillMoneyFin}</td>
            <td class="p-2 border-r border-espresso">${r.payDateFin || '—'}</td>
            <td class="p-2 border-r-2 border-espresso">${r.fillMoneyVendorCre}</td>
            <td class="p-2 border-r border-espresso">${r.statusGeneral}</td>
            <td class="p-2 border-r border-espresso font-bold bg-sageLight/50 text-sage">${r.nextStep}</td>
            <td class="p-2 font-mono text-[10px] text-sky hover:underline">${r.driveLink ? `<a href="${r.driveLink}" target="_blank">Drive</a>` : '—'}</td>
          </tr>
        `;
      });
      tbody.innerHTML = html || '<tr><td colspan="20" class="p-4 text-center text-espresso/50">Không có dữ liệu!</td></tr>';
    }

    // 7. RENDER BẢNG KANBAN TIẾN ĐỘ PO
    function renderKanban() {
      const cols = {
        'ChuaTrinh': document.getElementById('kanbanCol_ChuaTrinh'),
        'DaTrinh': document.getElementById('kanbanCol_DaTrinh'),
        'DaKy': document.getElementById('kanbanCol_DaKy'),
        'DaGuiVendor': document.getElementById('kanbanCol_DaGuiVendor')
      };
      const counts = { 'ChuaTrinh': 0, 'DaTrinh': 0, 'DaKy': 0, 'DaGuiVendor': 0 };

      Object.values(cols).forEach(c => c.innerHTML = '');

      freelanceData.forEach((item, index) => {
        let key = 'ChuaTrinh';
        if (item.poSignStatus === 'Đã trình') key = 'DaTrinh';
        if (item.poSignStatus === 'Đã ký') key = 'DaKy';
        if (item.poSignStatus === 'Đã gửi Vendor') key = 'DaGuiVendor';

        counts[key]++;

        const card = document.createElement('div');
        card.className = "bg-white p-3 rounded-xl border-2 border-espresso shadow-retro-sm text-xs space-y-1.5";
        card.innerHTML = `
          <div class="flex items-center justify-between font-game font-bold">
            <span class="text-coral text-sm">${item.freelanceName}</span>
            <span class="text-[10px] bg-latte px-1.5 py-0.5 rounded border border-espresso">${item.entity}</span>
          </div>
          <div class="text-[11px] text-espresso/70 truncate">${item.camName || 'Chưa có campaign'}</div>
          <div class="font-bold text-sage">${item.freelanceMoney.toLocaleString('vi-VN')} ₫</div>
          <div class="pt-2 border-t border-espresso/10 flex justify-between gap-1">
            <button onclick="advancePOStatus(${index})" class="flex-1 py-1 bg-mustard hover:bg-mustard/90 text-espresso font-game font-bold rounded-lg border border-espresso text-[10px] btn-bouncy">
              Tiến ➔
            </button>
            <button onclick="pickForEmail(${index})" class="px-2 py-1 bg-latte text-espresso font-game rounded-lg border border-espresso text-[10px] btn-bouncy">
              ✉️
            </button>
          </div>
        `;
        cols[key].appendChild(card);
      });

      document.getElementById('badgeCount_ChuaTrinh').innerText = counts.ChuaTrinh;
      document.getElementById('badgeCount_DaTrinh').innerText = counts.DaTrinh;
      document.getElementById('badgeCount_DaKy').innerText = counts.DaKy;
      document.getElementById('badgeCount_DaGuiVendor').innerText = counts.DaGuiVendor;
    }

    // CHUYỂN NHANH TRẠNG THÁI PO TRÊN KANBAN
    function advancePOStatus(index) {
      playChime(650);
      const curr = freelanceData[index].poSignStatus;
      if (curr === 'Chưa trình') freelanceData[index].poSignStatus = 'Đã trình';
      else if (curr === 'Đã trình') freelanceData[index].poSignStatus = 'Đã ký';
      else if (curr === 'Đã ký') freelanceData[index].poSignStatus = 'Đã gửi Vendor';
      
      freelanceData[index].nextStep = calcNextStep(freelanceData[index]);
      renderAll();
    }

    // 8. TỰ ĐỘNG ĐỔ DATA VÀO EMAIL 1-CLICK
    function pickForEmail(index) {
      const item = freelanceData[index];
      document.getElementById('emailField_entity').value = item.entity || 'AMV';
      document.getElementById('emailField_cam').value = item.camName || '';
      document.getElementById('emailField_id').value = item.poId || 'CAM0083383';
      updateEmailBox();
      openModal('modalEmail');
    }

    function updateEmailBox() {
      const ent = document.getElementById('emailField_entity').value;
      const cam = document.getElementById('emailField_cam').value;
      const id = document.getElementById('emailField_id').value;
      const pic = document.getElementById('emailField_pic').value;

      const sub = `Re: [|INT| ${ent} x ${cam} - D2C - ${id} - CONTRACT REVIEW]`;
      const body = `Dear anh/chị ${pic} và Legal team,\n\nAnh/chị và Team cho em gửi BBNT và PO của project ${cam}, nhờ anh/chị và team check và note lại giúp em nhé ạ.\n\nDear chị ${pic},\n\nEm nhờ chị gửi giúp em số PO cho PO này luôn nhé ạ.\n\nEm cảm ơn mọi người nhiều ạ.`;

      document.getElementById('emailBoxContent').innerText = `${sub}\n\n${body}`;
    }

    function copyEmailText() {
      const text = document.getElementById('emailBoxContent').innerText;
      navigator.clipboard.writeText(text);
      playChime(880);
      confetti({ particleCount: 40, spread: 50 });
      alert("📋 Đã copy xong tiêu đề và nội dung email!");
    }

    // 9. TRỢ LÝ PUDDING BOT
    function handleBotAsk() {
      const q = document.getElementById('botQueryInput').value.toLowerCase().trim();
      if (!q) return;
      playChime(600);

      const box = document.getElementById('botAnswerBox');
      
      // Case tìm tên bạn Freelance
      for (let f of freelanceData) {
        if (q.includes(f.freelanceName.toLowerCase())) {
          box.innerHTML = `
            <div class="space-y-1">
              <div class="font-game font-bold text-coral text-sm">🔎 TÌM THẤY: ${f.freelanceName.toUpperCase()}</div>
              <div>• Campaign: <b>${f.camName || 'Chưa điền'}</b> (${f.entity})</div>
              <div>• Tiền Freelance: <b>${f.freelanceMoney.toLocaleString('vi-VN')} ₫</b> | Vendor: <b>${f.vendorMoney.toLocaleString('vi-VN')} ₫</b></div>
              <div>• Trạng thái PO: <b>${f.poStatus}</b> (ID: <code>${f.poId || 'THIẾU'}</code>)</div>
              <div>• Trình ký: <b>${f.poSignStatus}</b></div>
              <div class="mt-2 p-2 bg-mustardLight rounded-lg border border-espresso font-bold text-espresso">
                ${f.nextStep}
              </div>
            </div>
          `;
          return;
        }
      }

      if (q.includes('diễm')) {
        box.innerHTML = "💡 <b>Khi nào báo Diễm?</b><br>Ngay sau khi có số PO từ FIN ➔ Điền số PO vào file ➔ Gửi bản mềm cho CRE ➔ Nhắn Diễm làm HĐ Freelance ngay nhé!";
        return;
      }

      if (q.includes('hóa đơn nháp') || q.includes('hoá đơn nháp')) {
        box.innerHTML = "💡 <b>Hóa đơn nháp:</b><br>Sau khi update Sheet PO ANM x CRE ➔ CRE sẽ xuất HĐ nháp ➔ Bồ confirm để chuyển sang bước xin ứng tiền.";
        return;
      }

      box.innerHTML = "❓ Chưa thấy bạn này trong danh sách. Bồ thử gõ đúng tên như: <b>'Trâm'</b>, <b>'Nga'</b>, <b>'Phong'</b> hoặc hỏi <b>'Diễm'</b> nhé!";
    }

    // 10. TÍNH TOÁN METRICS TỔNG
    function updateMetrics() {
      let fUnpaid = 0, vUnpaid = 0;
      freelanceData.forEach(d => {
        if (d.fillMoneyFin !== 'Đã điền') {
          fUnpaid += d.freelanceMoney;
          vUnpaid += d.vendorMoney;
        }
      });
      document.getElementById('quickFreelanceUnpaid').innerText = fUnpaid.toLocaleString('vi-VN') + ' ₫';
      document.getElementById('quickVendorUnpaid').innerText = vUnpaid.toLocaleString('vi-VN') + ' ₫';
    }

    function resetMockData() {
      playChime(600);
      renderAll();
    }

    function renderAll() {
      renderTable();
      renderKanban();
      updateMetrics();
      updateEmailBox();
    }

    window.onload = function() {
      renderAll();
    };
  </script>
